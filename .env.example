# Copy to .env and fill in. Local dev works with everything unset
# (SQLite + console email + local Redis).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Postgres (deploy target). When POSTGRES_DB is unset, SQLite is used.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Redis (Channels layer + Celery broker).
REDIS_URL=redis://127.0.0.1:6379/0

# Email (OTP delivery). Dev default is the console backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@omnipax.local

# Bachs sandbox (build step 8).
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
